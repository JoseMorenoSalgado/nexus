# Primera instalación WEB (no incluir claves reales en Git)
# Habilitar SOLO durante la instalación, desde una red o acceso restringido.
# La primera sesión de navegador recibe automáticamente una cookie HttpOnly.
INSTALLER_AUTO_SETUP="false"
# Enhance: si APP_CONFIG_DIR no se define, se usa ~/nexus-runtime (persistente entre despliegues Git).
# Opcional: define una ruta absoluta privada fuera de deploys/current y de public.
# APP_CONFIG_DIR="/home/usuario/nexus-runtime"
# Plesk/Docker: usa una ruta privada persistente o un volumen con permisos de escritura.
# Nunca guardes credenciales reales en este archivo ni lo copies a Git.
# No definas DATABASE_URL si deseas introducir la conexión desde /instalar.
# Si defines DATABASE_URL directamente se omite el asistente inicial.

# Vista previa opcional y restringida al host de pruebas
SITE_PREVIEW_MODE="false"
SITE_PREVIEW_HOST="inmo.elearningcloud.org"

# Sólo para desarrollo / scripts anteriores de inicialización, no para el wizard
# DATABASE_URL="mysql://usuario:clave@127.0.0.1:3306/nexus_db"
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# SEED_DOMAIN="localhost"
