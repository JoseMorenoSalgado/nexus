generator client {
  provider = "prisma-client-js"
  output = "../src/generated/postgres"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


model Property {
  id String @id @default(cuid())
  slug String
  refCode String
  title String
  description String @db.Text
  city String
  neighborhood String?
  type String
  operation String
  price Decimal @db.Decimal(13,2)
  bedrooms Int?
  bathrooms Int?
  areaM2 Int?
  featured Boolean @default(false)
  published Boolean @default(false)
  photos Photo[]
  leads Lead[]
  closings CommercialClosing[]
  assignedAgentId String?
  assignedAgent AdminUser? @relation("AgentProperties",fields:[assignedAgentId],references:[id],onDelete:SetNull)
  @@index([assignedAgentId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([slug])
  @@unique([refCode])
}
model Photo {
  id String @id @default(cuid())
  propertyId String
  property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
  url String
  alt String?
  sortOrder Int @default(0)
  @@index([propertyId,sortOrder])
}
model Lead {
  id String @id @default(cuid())
  propertyId String?
  property Property? @relation(fields:[propertyId],references:[id],onDelete:SetNull)
  name String
  email String?
  phone String
  message String? @db.Text
  source String @default("web")
  externalPropertyInterest String? @db.VarChar(300)
  consent Boolean @default(false)
  crm LeadCrm?
  notes LeadNote[]
  assignedAgentId String?
  assignedAgent AdminUser? @relation("AgentLeads",fields:[assignedAgentId],references:[id],onDelete:SetNull)
  assignmentHistory LeadAssignmentHistory[]
  propertyHistory LeadPropertyHistory[]
  agendaEvents AgendaEvent[]
  closing CommercialClosing?
  createdAt DateTime @default(now())
}
model VisitEvent {
  id String @id @default(cuid())
  kind String
  path String?
  createdAt DateTime @default(now())
}
model SitePage {
  id String @id @default(cuid())
  slug String
  title String
  blocks Json
  published Boolean @default(false)
  updatedAt DateTime @updatedAt
  @@unique([slug])
}
model AdminUser {
  id String @id @default(cuid())
  email String
  name String
  passwordHash String
  role String @default("admin")
  active Boolean @default(true)
  sessions AdminSession[]
  assignedProperties Property[] @relation("AgentProperties")
  assignedLeads Lead[] @relation("AgentLeads")
  closings CommercialClosing[] @relation("AgentClosings")
  createdAt DateTime @default(now())
  @@unique([email])
}
model AdminSession {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user AdminUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model AdminLoginThrottle {
  key String @id
  attempts Int @default(0)
  expiresAt DateTime
}

/**
 * Additive CRM tables: no changes to legacy Lead columns or records.
 * Created via the admin-authorized CRM activation after deployment.
 */
model LeadCrm {
  id String @id @default(cuid())
  leadId String @unique
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status String @default("nuevo")
  nextContactAt DateTime?
  updatedAt DateTime @updatedAt
}
model LeadNote {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorName String
  body String @db.Text
  createdAt DateTime @default(now())
}

/** Immutable snapshots of changes in the prospect's responsible agent.
 * Names are saved to preserve the audit trail after an account is removed.
 */
model LeadAssignmentHistory {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  fromAgentId String?
  fromAgentName String?
  toAgentId String?
  toAgentName String?
  changedByName String
  createdAt DateTime @default(now())
}

/** Scheduled commercial activity is linked to a lead; transferring the lead
 * also transfers access to its future and historical agenda entries.
 */
model AgendaEvent {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  type String
  title String
  startsAt DateTime
  durationMinutes Int @default(60)
  location String?
  meetingUrl String? @db.VarChar(500)
  notes String? @db.Text
  status String @default("pendiente")
  createdByName String
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** A verified-by-staff commercial transaction is a separate ledger entry.
 * A lead CRM status "cerrado" does NOT imply a completed sale or rental.
 * Keep financial records when a lead/property is reassigned.
 */
model CommercialClosing {
  id String @id @default(cuid())
  leadId String @unique
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Restrict)
  propertyId String
  property Property @relation(fields:[propertyId],references:[id],onDelete:Restrict)
  agentId String?
  agent AdminUser? @relation("AgentClosings",fields:[agentId],references:[id],onDelete:SetNull)
  agentName String
  propertyRefCode String
  clientName String
  kind String
  currency String @default("USD")
  amount Decimal @db.Decimal(13,2)
  commissionAmount Decimal @db.Decimal(13,2)
  closedAt DateTime
  notes String? @db.Text
  status String @default("confirmado")
  voidReason String? @db.Text
  voidedAt DateTime?
  voidedByName String?
  createdByName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  commissionPayments CommissionPayment[]
}

/** Append-only commission payment ledger. Corrections void entries, never delete them. */
model CommissionPayment {
 id String @id @default(cuid())
 closingId String
 closing CommercialClosing @relation(fields:[closingId],references:[id],onDelete:Restrict)
 amount Decimal @db.Decimal(13,2)
 paidAt DateTime
 method String @default("transferencia")
 reference String?
 notes String? @db.Text
 createdByName String
 status String @default("confirmado")
 voidReason String? @db.Text
 voidedAt DateTime?
 voidedByName String?
 createdAt DateTime @default(now())
}


/** Tenant-scoped, transactional next-number allocator. Existing Property.refCode never changes. */
model PropertySequence {
  id String @id @default("main")
  prefix String @default("NRE")
  nextNumber Int @default(1)
  updatedAt DateTime @updatedAt
}

/** Sources can be disabled without changing historical Lead.source values. */
model LeadSource {
  id String @id @default(cuid())
  code String
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([code])
}

/** Append-only property association history for existing and external interests. */
model LeadPropertyHistory {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  fromPropertyId String?
  fromRef String?
  fromExternalDescription String? @db.VarChar(300)
  toPropertyId String?
  toRef String?
  externalDescription String? @db.VarChar(300)
  changedByName String
  createdAt DateTime @default(now())
}

model SiteConfig {
  id String @id @default("main")
  name String
  tagline String?
  whatsapp String?
  contactEmail String?
  logoUrl String?
  primaryColor String @default("#CB2027")
  updatedAt DateTime @updatedAt
}
