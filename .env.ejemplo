# Nexus Real Estate — plantilla para Enhance (sin credenciales reales)
# Renombrar este archivo a .env en el servidor, junto a package.json.
# El archivo .env contiene secretos: NUNCA subirlo a Git.

NODE_ENV=production
SITE_PREVIEW_MODE=false

# Instalador inicial: formulario directo en /instalar (requiere desplegar PR #46).
INSTALLER_ENABLED=true
INSTALLER_AUTO_SETUP=true

# Estado persistente entre despliegues: por defecto usa ~/nexus-runtime.
# Solo establecer APP_CONFIG_DIR si conoces la ruta absoluta privada.
# APP_CONFIG_DIR=/ruta/privada/nexus-runtime

# PostgreSQL: dejar sin configurar para introducir los datos desde /instalar.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE?schema=public

# No añadir contraseñas reales, claves de activación ni credenciales SMTP aquí.
